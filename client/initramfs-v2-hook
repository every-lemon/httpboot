# Appended to the common initramfs hook only for protocol 2 bootstrap images.
copy_exec /usr/bin/python3
copy_exec /usr/bin/openssl
copy_exec /usr/sbin/kexec
mkdir -p "$DESTDIR/usr/lib/ssl" "$DESTDIR/etc/ssl" "$DESTDIR/httpboot/v2"
cp -a /usr/lib/python3.* "$DESTDIR/usr/lib/"
for extension in /usr/lib/python3.*/lib-dynload/*.so;do copy_exec "$extension";done
cp /etc/ssl/openssl.cnf "$DESTDIR/etc/ssl/"
ln -sf /etc/ssl/openssl.cnf "$DESTDIR/usr/lib/ssl/openssl.cnf"
cp /etc/httpboot-build/server-ca.pem /etc/httpboot-build/client-v2.json "$DESTDIR/httpboot/"
cp /etc/httpboot-build/v2/*.py "$DESTDIR/httpboot/v2/"
cp /usr/local/lib/httpboot/init-v2-rest "$DESTDIR/httpboot/"
chmod 755 "$DESTDIR/httpboot/init-v2-rest"
